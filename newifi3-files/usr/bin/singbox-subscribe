#!/bin/sh
# singbox-subscribe —— 从机场订阅拉取节点，按关键字筛选后生成 sing-box 配置
#
# 为什么需要它：机场节点换得快，写死在 config.json 里的节点过期后整条线会挂，
# 表现为“能上国内、上不了国外”，看门狗再把代理停掉，直到你手动更新。
#
# 用法：
#   singbox-subscribe              拉订阅、更新配置、校验、平滑重启
#   singbox-subscribe -n           只拉取并打印统计，不写配置（dry-run）
#   singbox-subscribe -f FILE      从本地文件读订阅内容（不联网，用于测试）
#   singbox-subscribe -l           列出订阅里的节点名，不做任何改动
#
# 依赖文件：
#   /etc/sing-box/subscription.url      订阅链接（600，勿入库）
#   /etc/sing-box/nodes.pool.json       输出：订阅里的全部节点（本脚本只写这个）
#   /etc/sing-box/subscription.filter   新节点的默认取舍规则，一行一个：
#                                         c17s2         白名单，只默认启用命中这些的
#                                         !过期         默认停用命中这些的
#                                         #@min 2       启用数少于 2 个时允许补位
#                                       只对“你还没明确选择过”的节点生效；在面板里
#                                       勾过的节点不会被这里覆盖。
#
# 分工（重要）：本脚本不写 config.json。它只负责把节点放进池子，然后调用
#   singbox-nodes auto    给未决定的新节点定默认值
#   singbox-nodes apply   按选择状态生成 outbounds 并生效
# 这样面板和定时任务不会互相覆盖。
#
# 安全：订阅链接等同于账号密码，脚本不会把它写进日志。
#
# 依赖：jq（ImmortalWrt 25.x 用 apk / opkg 均可，约 250KB）
#   固件里已经通过 CONFIG_PACKAGE_jq=y 预置；手动装：apk add jq
#   base64 不依赖外部命令 —— 解码走 jq 的 @base64d（busybox 默认没编 base64）

set -u

CONF=${SINGBOX_SUB_CONF:-/etc/sing-box/config.json}
URLF=${SINGBOX_SUB_URL_FILE:-/etc/sing-box/subscription.url}
FILTF=${SINGBOX_SUB_FILTER:-/etc/sing-box/subscription.filter}
POOL=${SINGBOX_POOL:-/etc/sing-box/nodes.pool.json}
SEL=${SINGBOX_SEL:-/etc/sing-box/nodes.selected.json}
NODES_BIN=${SINGBOX_NODES_BIN:-/usr/bin/singbox-nodes}
WORK=/tmp/sb-sub
TAG=singbox-subscribe
MAX_NODES=32
export SINGBOX_POOL="$POOL" SINGBOX_SEL="$SEL" SINGBOX_SUB_CONF="$CONF" SINGBOX_SUB_FILTER="$FILTF"
UA="sing-box/1.14.3"

DRY=0
LIST=0
SRC_FILE=""

while [ $# -gt 0 ]; do
	case "$1" in
		-n|--dry-run) DRY=1 ;;
		-l|--list)    LIST=1 ;;
		-f|--file)    SRC_FILE="${2:-}"; shift ;;
		-h|--help)    sed -n '2,30p' "$0"; exit 0 ;;
		*) echo "未知参数: $1" >&2; exit 2 ;;
	esac
	shift
done

log() { logger -t "$TAG" "$*"; echo "$*"; }
die() { logger -t "$TAG" "ERROR: $*"; echo "ERROR: $*" >&2; exit 1; }

b64d() {
	# base64 解码统一走 jq（@base64d），不依赖 coreutils-base64 ——
	# 这个固件里 busybox 没编 base64，单独装包又要多 ~250KB 和一条依赖链。
	# 处理三件事：去换行、把 base64url 的 -_ 换回 +/、补齐 padding。
	#
	# 必须先于调用点定义：解析格式（识别 base64 订阅）在第 90 行左右就会用到它，
	# 放在后面的函数区会报 "b64d: not found"。
	s=$(printf '%s' "$1" | tr -d '\r\n ' | tr -- '-_' '+/')
	case $(( ${#s} % 4 )) in
		2) s="$s==" ;;
		3) s="$s=" ;;
	esac
	printf '%s' "$s" | jq -Rr '@base64d' 2>/dev/null
}


rm -rf "$WORK"; mkdir -p "$WORK"

# ---------------------------------------------------------------- 取回订阅
raw="$WORK/raw"

if [ -n "$SRC_FILE" ]; then
	[ -s "$SRC_FILE" ] || die "文件为空或不存在: $SRC_FILE"
	cp "$SRC_FILE" "$raw"
else
	[ -s "$URLF" ] || die "缺少订阅链接文件 $URLF（chmod 600，内容是完整 URL）"
	url=$(tr -d '\r\n' < "$URLF")

	case "$url" in
		http://*|https://*) ;;
		*) die "$URLF 里不是一个 http(s) 链接" ;;
	esac

	if ! uclient-fetch -q -T 20 -U "$UA" -O "$raw" "$url" 2>/dev/null; then
		sleep 2
		uclient-fetch -q -T 25 -U "$UA" -O "$raw" "$url" 2>/dev/null || die "订阅下载失败（网络或链接失效）"
	fi
	[ -s "$raw" ] || die "订阅内容为空"
fi

# ---------------------------------------------------------------- 识别格式
# 三种常见形态：sing-box JSON / Clash YAML / base64(分享链接列表)
uris="$WORK/uris"
mode=""

first=$(head -c 1 "$raw" 2>/dev/null)

if [ "$first" = "{" ]; then
	mode=json
elif grep -qiE '^[[:space:]]*proxies[[:space:]]*:' "$raw" 2>/dev/null; then
	mode=yaml
else
	# 可能是 base64，也可能本身就是明文分享链接
	if grep -q '://' "$raw" 2>/dev/null; then
		mode=plain
		tr -d '\r' < "$raw" | grep '://' > "$uris"
	else
		b64d "$(cat "$raw")" > "$WORK/dec"
		grep '://' "$WORK/dec" > "$uris" 2>/dev/null
		mode=b64
	fi
fi

case "$mode" in
	yaml)
		die "订阅是 Clash YAML 格式，本脚本不解析（YAML 需要 yq，路由器上没有）。
     解决办法：在订阅链接后加机场的「通用/base64」参数，或改用 base64 订阅地址。"
		;;
	json)
		# sing-box / v2ray JSON：直接把 outbounds 里可用的节点抽出来
		jq -c '.outbounds[]?
		       | select(.type != "selector" and .type != "urltest"
		                and .type != "direct" and .type != "block" and .type != "dns")
		       | select((.server // "") != "")' "$raw" > "$WORK/nodes.ndjson" 2>/dev/null
		[ -s "$WORK/nodes.ndjson" ] || die "JSON 订阅里没有找到可用 outbound"
		;;
	plain|b64)
		[ -s "$uris" ] || die "订阅里没有解析出任何节点链接"
		;;
esac

# ---------------------------------------------------------------- 解析链接
# 只支持这几种主流协议；其他（hysteria/tuic 等）跳过并计数
qval() {
	# $1=query 串 $2=键名
	printf '%s' "$1" | tr '&' '\n' | sed -n "s/^$2=//p" | head -n 1
}

urld() {
	# URL 解码（jq 1.8 的 @urid），失败时原样返回
	printf '%s' "$1" | jq -Rr '@urid' 2>/dev/null || printf '%s' "$1"
}

parse_vless() {
	# $1=scheme 之后的整体
	body=$1
	case "$body" in *"#"*) frag=${body#*#}; body=${body%%#*} ;; *) frag="" ;; esac
	case "$body" in *"?"*) query=${body#*\?}; body=${body%%\?*} ;; *) query="" ;; esac
	user=${body%@*}; hp=${body##*@}

	host=${hp%:*}; port=${hp##*:}
	case "$host" in \[*\]) host=$(printf '%s' "$host" | tr -d '[]') ;; esac
	case "$port" in ''|*[!0-9]*) port=443 ;; esac

	sec=$(qval "$query" security); [ -n "$sec" ] || sec=tls
	sni=$(urld "$(qval "$query" sni)")
	pbk=$(qval "$query" pbk)
	sid=$(qval "$query" sid)
	fp=$(qval "$query" fp)
	flow=$(qval "$query" flow)
	net=$(qval "$query" type)
	[ -n "$net" ] || net=tcp
	path=$(urld "$(qval "$query" path)")
	hhost=$(urld "$(qval "$query" host)")
	name=$(urld "$frag")
	[ -n "$name" ] || name="$host:$port"

	jq -cn \
		--arg tag "$name" --arg server "$host" --argjson port "$port" --arg uuid "$user" \
		--arg flow "$flow" --arg sni "$sni" --arg fp "$fp" --arg pbk "$pbk" --arg sid "$sid" \
		--arg net "$net" --arg path "$path" --arg hhost "$hhost" --arg sec "$sec" '
		{ type: "vless", tag: $tag, server: $server, server_port: $port, uuid: $uuid }
		+ (if $flow != "" and $flow != "none" then { flow: $flow } else {} end)
		+ (if ($sec == "tls" or $sec == "reality") then
			{ tls: ({ enabled: true }
				+ (if $sni != "" then { server_name: $sni } else {} end)
				+ (if $fp  != "" then { utls: { enabled: true, fingerprint: $fp } } else {} end)
				+ (if $sec == "reality" then
					{ reality: ({ enabled: true }
						+ (if $pbk != "" then { public_key: $pbk } else {} end)
						+ (if $sid != "" then { short_id: $sid } else {} end)) }
				   else {} end)) }
		   else {} end)
		+ (if $net == "ws" then
			{ transport: ({ type: "ws" }
				+ (if $path  != "" then { path: $path } else {} end)
				+ (if $hhost != "" then { headers: { Host: $hhost } } else {} end)) }
		   elif $net == "grpc" then
			{ transport: { type: "grpc", service_name: (if $path != "" then $path else "" end) } }
		   else {} end)
	'
}

parse_trojan() {
	body=$1
	case "$body" in *"#"*) frag=${body#*#}; body=${body%%#*} ;; *) frag="" ;; esac
	case "$body" in *"?"*) query=${body#*\?}; body=${body%%\?*} ;; *) query="" ;; esac
	pass=${body%@*}; hp=${body##*@}

	host=${hp%:*}; port=${hp##*:}
	case "$host" in \[*\]) host=$(printf '%s' "$host" | tr -d '[]') ;; esac
	case "$port" in ''|*[!0-9]*) port=443 ;; esac

	sni=$(urld "$(qval "$query" sni)")
	[ -n "$sni" ] || sni=$(urld "$(qval "$query" peer)")
	[ -n "$sni" ] || sni="$host"
	name=$(urld "$frag")
	[ -n "$name" ] || name="$host:$port"

	jq -cn --arg tag "$name" --arg server "$host" --argjson port "$port" \
		--arg pass "$pass" --arg sni "$sni" '
		{ type: "trojan", tag: $tag, server: $server, server_port: $port,
		  password: $pass, tls: { enabled: true, server_name: $sni } }'
}

parse_ss() {
	body=$1
	case "$body" in *"#"*) frag=${body#*#}; body=${body%%#*} ;; *) frag="" ;; esac
	case "$body" in *"?"*) query=${body#*\?}; body=${body%%\?*} ;; *) query="" ;; esac
	user=${body%@*}; hp=${body##*@}

	host=${hp%:*}; port=${hp##*:}
	case "$host" in \[*\]) host=$(printf '%s' "$host" | tr -d '[]') ;; esac
	case "$port" in ''|*[!0-9]*) port=443 ;; esac

	case "$user" in
		*:*)
			method=${user%%:*}
			pass=${user#*:}
			;;
		*)
			dec=$(b64d "$user")
			case "$dec" in
				*@*)
					# 老格式：整段 base64(method:pass@host:port)
					method=${dec%%:*}
					rest=${dec#*:}
					pass=${rest%%@*}
					inner=${dec##*@}
					host=${inner%:*}; port=${inner##*:}
					;;
				*)
					method=${dec%%:*}
					pass=${dec#*:}
					;;
			esac
			;;
	esac

	name=$(urld "$frag")
	[ -n "$name" ] || name="$host:$port"

	jq -cn --arg tag "$name" --arg server "$host" --argjson port "$port" \
		--arg method "$method" --arg pass "$pass" '
		{ type: "shadowsocks", tag: $tag, server: $server, server_port: $port,
		  method: $method, password: $pass }'
}

parse_vmess() {
	dec=$(b64d "$1")
	[ -n "$dec" ] || return 1
	printf '%s' "$dec" | jq -e . >/dev/null 2>&1 || return 1

	printf '%s' "$dec" | jq -c '
		{
		  type: "vmess",
		  tag: (if (.ps // "") == "" then ((.add // "") + ":" + ((.port // 0) | tostring)) else .ps end),
		  server: .add,
		  server_port: ((.port // 0) | tonumber),
		  uuid: .id,
		  alter_id: ((.aid // 0) | tonumber),
		  security: (.scy // "auto")
		}
		+ (if ((.tls // "") == "tls") then { tls: { enabled: true, server_name: (if (.sni // "") == "" then .add else .sni end) } } else {} end)
		+ (if ((.net // "tcp") == "ws") then
			{ transport: ({ type: "ws" }
				+ (if (.path // "") != "" then { path: .path } else {} end)
				+ (if (.host // "") != "" then { headers: { Host: .host } } else {} end)) }
		   else {} end)
	' 2>/dev/null
}

nodes="$WORK/nodes.ndjson"
: > "$nodes"

skipped=0
parsed=0

if [ "$mode" = "json" ]; then
	cp "$WORK/nodes.ndjson" "$WORK/json-nodes"
	cp "$WORK/json-nodes" "$nodes"
	parsed=$(wc -l < "$nodes")
else
	while IFS= read -r uri; do
		[ -n "$uri" ] || continue
		scheme=$(printf '%s' "$uri" | sed -n 's#^\([a-zA-Z0-9]*\)://.*#\1#p' | tr 'A-Z' 'a-z')
		rest=${uri#*://}
		out=""
		case "$scheme" in
			vless)  out=$(parse_vless "$rest") ;;
			trojan) out=$(parse_trojan "$rest") ;;
			ss)     out=$(parse_ss "$rest") ;;
			vmess)  out=$(parse_vmess "$rest") ;;
			*)      skipped=$((skipped + 1)); continue ;;
		esac
		[ -n "$out" ] || { skipped=$((skipped + 1)); continue; }
		printf '%s\n' "$out" >> "$nodes"
		parsed=$((parsed + 1))
	done < "$uris"
fi

[ "$parsed" -gt 0 ] || die "一个节点都没解析出来（共跳过 $skipped 个不支持的协议）"

# ---------------------------------------------------------------- 写节点池
# 池子里放“订阅里有的全部节点”，不做取舍 —— 取舍属于用户的选择，记在
# nodes.selected.json 里，由 singbox-nodes 统一处理。这样两个入口不再互相覆盖：
#   订阅刷新  -> 只改池子
#   面板勾选  -> 只改选择状态
#   config.json -> 只由 singbox-nodes 生成

total_raw=$(wc -l < "$nodes" | tr -d ' ')

# 超过上限则截断（顺序即订阅顺序，机场通常把好节点排前面）
if [ "$total_raw" -gt "$MAX_NODES" ]; then
	head -n "$MAX_NODES" "$nodes" > "$WORK/nodes.cap" && mv "$WORK/nodes.cap" "$nodes"
	total_raw=$MAX_NODES
fi

# tag 去重：同名节点加序号，否则 sing-box 会因 tag 冲突拒绝启动
jq -s '
	reduce .[] as $n ({ seen: {}, out: [] };
		(($n.tag // "node") | tostring) as $base
		| ( .seen[$base] // 0 ) as $c
		| .seen[$base] = ($c + 1)
		| .out += [ $n + { tag: (if $c == 0 then $base else ($base + " #" + (($c + 1) | tostring)) end) } ]
	) | .out
' "$nodes" > "$WORK/nodes.json" 2>/dev/null || die "节点 JSON 合并失败"

total=$(jq 'length' "$WORK/nodes.json")
[ "$total" -gt 0 ] || die "订阅里没有解析出任何节点"

if [ "$LIST" = "1" ]; then
	jq -r '.[].tag' "$WORK/nodes.json"
	exit 0
fi

jq --argjson ts "$(date +%s)" '{ updated: $ts, nodes: . }' "$WORK/nodes.json" > "$WORK/pool.preview.json" \
	|| die "生成节点池失败"

if [ "$DRY" = "1" ]; then
	echo "格式=$mode  解析=$parsed  跳过=$skipped  池中节点=$total"
	echo "--- 池中全部节点 ---"
	jq -r '.[].tag' "$WORK/nodes.json"
	echo "--- 按筛选规则给「未决定」节点的默认值 ---"
	SINGBOX_POOL="$WORK/pool.preview.json" "$NODES_BIN" -n auto 2>&1 | sed 's/^/  /'
	exit 0
fi

[ -x "$NODES_BIN" ] || die "缺少 $NODES_BIN（节点池生成器未安装）"

mv "$WORK/pool.preview.json" "$POOL" || die "写节点池失败"
chmod 600 "$POOL" 2>/dev/null
log "节点池已更新：$total 个节点"

# 给“还没被选择过”的节点定默认值，再按选择状态重建 config.json 并生效
"$NODES_BIN" auto  || die "自动选择失败"
"$NODES_BIN" apply || die "生成配置失败"

exit 0
