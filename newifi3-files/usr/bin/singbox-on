#!/bin/sh
# 在路由器上填好 /etc/sing-box/config.json 后执行本脚本：
#   - 校验配置
#   - 启动 sing-box（失败则不改 dnsmasq，避免断网）
#   - 成功后把 dnsmasq 改为只做 DHCP，LAN DNS 指向 223.5.5.5（由 TUN 接管）
set -e

CFG=/etc/sing-box/config.json

if grep -q '"YOUR_' "$CFG"; then
	echo "ERROR: $CFG still contains YOUR_* placeholders" >&2
	echo "Edit it first (vi or scp), then run this script again." >&2
	exit 1
fi

sing-box check -c "$CFG"

uci set sing-box.main.enabled='1'
uci commit sing-box
/etc/init.d/sing-box enable
/etc/init.d/sing-box restart

sleep 1
i=0
while [ "$i" -lt 10 ]; do
	pidof sing-box >/dev/null 2>&1 && break
	sleep 1
	i=$((i + 1))
done

if ! pidof sing-box >/dev/null 2>&1; then
	echo "ERROR: sing-box failed to start; dnsmasq left unchanged" >&2
	logread -e sing-box | tail -n 30 >&2
	exit 1
fi

uci set dhcp.@dnsmasq[0].port='0'
uci -q delete dhcp.lan.dhcp_option
uci add_list dhcp.lan.dhcp_option='6,223.5.5.5'
uci commit dhcp
/etc/init.d/dnsmasq restart

echo "--- sing-box status ---"
/etc/init.d/sing-box status || true
echo "--- last log ---"
logread -e sing-box | tail -n 20
echo "OK: sing-box is running; dnsmasq DNS disabled, LAN DNS -> 223.5.5.5"
