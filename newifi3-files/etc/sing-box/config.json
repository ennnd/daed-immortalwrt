{
  // ====================================================================
  // sing-box 1.14.x 配置模板
  //   Newifi3 (Newifi D2) / ImmortalWrt 25.12.2 / sing-box-tiny 1.14.3
  //
  // 出厂带占位符（server / uuid / 密钥等几处），sing-box 默认不启动；
  // 填好节点后执行 singbox-on，或在 LuCI「服务 → Sing-Box」里点启用。
  // 判断"是否还有占位符"只匹配带引号的字段值，不匹配注释，所以注释随便写。
  // 改完先自检：sing-box check -c /etc/sing-box/config.json
  // 本文件支持 // 注释（sing-box 的 JSON 解析器允许注释）。
  //
  // ★ 节点的 "server" 字段请填**域名**，不要填写死的 IP。
  //   机场的入口 IP 会轮换，历史上写死某个入口 IP 就因它过期导致整条线挂掉
  //   （具体 IP 属于节点凭据，不写进仓库，示例统一用 203.0.113.10）；
  //   填域名后 sing-box 会通过 default_domain_resolver 自动跟随解析。
  // ====================================================================
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    // 1.14：legacy DNS server 写法（address/tag 老格式）已在 1.12 弃用、1.14 移除，
    // 必须用 type + server。
    "servers": [
      {
        // 国内：DoT(853) 加密直连，不要用明文 UDP。
        // 明文 UDP 的应答在链路上会被运营商注入/劫持：实测 www.gstatic.com 这类
        // 域名会拿回 114.250.x（联通）的假地址；换成 DoT 后这条注入路径被 TLS 挡掉。
        "tag": "dns_cn",
        "type": "tls",
        "server": "223.5.5.5",
        "server_port": 853,
        "tls": { "server_name": "dns.alidns.com" },
        "detour": "direct"
      },
      {
        // 国外：DoH 走代理，避免 DNS 污染
        "tag": "dns_proxy",
        "type": "https",
        "server": "1.1.1.1",
        "detour": "proxy"
      }
    ],
    "rules": [
      // ★ 必须在 geosite-cn 之前：geosite-cn 里混进了 www.gstatic.com /
      //   ssl.gstatic.com / connectivitycheck.gstatic.com 这些 Google 域名
      //   （早期给国内 Android 连通性检查用的）。如果让它们走 dns_cn，
      //   阿里会返回无效地址（114.250.x 联通段），urltest 探测随之全灭。
      {
        "domain_suffix": [
          "gstatic.com",
          "google.com",
          "googleapis.com",
          "googleusercontent.com",
          "ggpht.com",
          "googlevideo.com",
          "gvt1.com",
          "gvt2.com",
          "youtube.com",
          "ytimg.com"
        ],
        "action": "route",
        "server": "dns_proxy"
      },
      {
        "rule_set": "geosite-cn",
        "action": "route",
        "server": "dns_cn"
      },
      {
        "domain_suffix": [
          ".cn"
        ],
        "action": "route",
        "server": "dns_cn"
      }
    ],
    "final": "dns_proxy",
    "strategy": "ipv4_only",
    // 1.14 新增：单次查询超时，默认 10s。路由器上 5s 足够。
    "timeout": "5s",
    // 1.14 新增：乐观缓存（缓存过期时先返回旧记录、后台刷新）。
    // 这里关掉：上游偶发抖动时旧记录可能是上一轮的脏数据，
    // 宁可多等一次查询，也不要把过期/被污染的 IP 发给客户端。
    "optimistic": false
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "tun0",
      "address": [
        "172.19.0.1/30"
      ],
      // mips 上的 sing-box-tiny 默认不编 gvisor（只在 arm/x86 默认开），
      // 所以栈必须用 system。（1.15 会弃用 stack，到时删掉这行即可）
      "stack": "system",
      // 显式给 1500，避免默认 9000 在 PPPoE(1492) 线路上出现 PMTU 黑洞；
      // 如果 WAN 是 PPPoE 且仍偶发卡顿，可以降到 1492。
      "mtu": 1500,
      "auto_route": true,
      "strict_route": false
    }
  ],
  "outbounds": [
    // >>> NODES BEGIN (managed by singbox-subscribe)
    {
      // proxy 是 route.final 指向的出口，也是 LuCI「节点选择」下拉框操作的对象。
      // 默认 auto（urltest 自动选延迟最低的节点）；想手动锁某台机器就在 UI 里选，
      // 或把下面 default 改成 "node1"/"node2"/"node3"。删掉某个节点时记得把
      // 它从 outbounds 列表一并删掉（LuCI 的「删除演示节点」会自动处理）。
      "type": "selector",
      "tag": "proxy",
      "outbounds": [
        "auto",
        "node1",
        "node2",
        "node3"
      ],
      "default": "auto"
    },
    {
      "type": "urltest",
      "tag": "auto",
      "outbounds": [
        "node1",
        "node2",
        "node3"
      ],
      // 探测目标不要用 www.gstatic.com：它被 geosite-cn 收录，容易跟着走国内 DNS
      // 解析到无效地址，导致所有节点被误判为不可用。
      "url": "https://cp.cloudflare.com/generate_204",
      "interval": "3m",
      "tolerance": 50
    },
    {
      // 节点 1：VLESS + Reality（推荐）
      "type": "vless",
      "tag": "node1",
      "server": "YOUR_SERVER",
      "server_port": 443,
      "uuid": "YOUR_UUID",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "YOUR_SNI",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        },
        "reality": {
          "enabled": true,
          "public_key": "YOUR_REALITY_PUBLIC_KEY",
          "short_id": "YOUR_REALITY_SHORT_ID"
        }
      }
    },
    {
      // 节点 2：Shadowsocks（AEAD）
      "type": "shadowsocks",
      "tag": "node2",
      "server": "YOUR_SERVER",
      "server_port": 8388,
      "method": "aes-256-gcm",
      "password": "YOUR_PASSWORD"
    },
    {
      // 节点 3：同节点 1，可换成另一台机器；不用就整段删掉，
      // 并把上面 urltest 的 outbounds 里的 "node3" 一并删掉。
      "type": "vless",
      "tag": "node3",
      "server": "YOUR_SERVER",
      "server_port": 443,
      "uuid": "YOUR_UUID",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "YOUR_SNI",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        },
        "reality": {
          "enabled": true,
          "public_key": "YOUR_REALITY_PUBLIC_KEY",
          "short_id": "YOUR_REALITY_SHORT_ID"
        }
      }
    },
    {
      // 1.14.3 要求被 DNS detour 引用的 direct 出站不能是"空"出站
      //（DialerOptions 全为默认值时 IsEmpty()==true，detour.go 会报
      // "detour to an empty direct outbound makes no sense"）。
      // 给任意一个非默认的拨号选项即可解除，这里用 reuse_addr（无害的
      // socket 选项，不影响路由）；切勿用 bind_interface，否则会把
      // 内网/直连流量全绑死到某个网口。
      "type": "direct",
      "tag": "direct",
      "reuse_addr": true
    }
    // <<< NODES END
  ],
  "route": {
    "rules": [
      {
        // 1.13 起 inbound 里的 sniff 字段已移除，嗅探只能写成 route 规则动作。
        // 四类显式列出：缺 dns 就拿不到 protocol=dns，下面 hijack-dns 失效；
        // 缺 quic 则 HTTP/3 流量嗅不到域名，会一路掉到 final 走代理。
        "action": "sniff",
        "sniffer": [
          "dns",
          "http",
          "tls",
          "quic"
        ],
        "timeout": "300ms"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      // 与 dns.rules 同理：这些域名虽然被 geosite-cn 收录，但直连必然失败，
      // 必须显式送到代理，且要排在 geosite-cn → direct 之前。
      {
        "domain_suffix": [
          "gstatic.com",
          "google.com",
          "googleapis.com",
          "googleusercontent.com",
          "ggpht.com",
          "googlevideo.com",
          "gvt1.com",
          "gvt2.com",
          "youtube.com",
          "ytimg.com"
        ],
        "outbound": "proxy"
      },
      {
        "rule_set": "geosite-cn",
        "outbound": "direct"
      },
      {
        "rule_set": "geoip-cn",
        "outbound": "direct"
      }
    ],
    "rule_set": [
      {
        "tag": "geosite-cn",
        "type": "local",
        "format": "binary",
        "path": "/etc/sing-box/rule-set/geosite-cn.srs"
      },
      {
        "tag": "geoip-cn",
        "type": "local",
        "format": "binary",
        "path": "/etc/sing-box/rule-set/geoip-cn.srs"
      }
    ],
    "final": "proxy",
    // 1.14 起凡是需要解析域名的场景都必须显式指定解析器，否则启动直接报
    // missing route.default_domain_resolver。
    "default_domain_resolver": {
      "server": "dns_cn"
    },
    // auto_detect_interface：TUN + auto_route 下必须的防环设置（直连按目的地址
    // 选出口，不会绕回 TUN）。但它依赖默认路由已存在，开机竞态会触发
    // "missing default interface" 并 NetworkPause 暂停网络；由
    // /etc/hotplug.d/iface/99-singbox 在 wan ifup 时重启 sing-box 规避，
    // 别删那个 hotplug 脚本。
    "auto_detect_interface": true
  },
  "experimental": {
    // 本地 Clash API：只监听 127.0.0.1，供 singbox-nodecheck 逐节点测延迟用。
    // 不要把地址改成 0.0.0.0 —— 那等于把节点控制和测速接口暴露给整个局域网。
    "clash_api": {
      "external_controller": "127.0.0.1:9090"
    },
    "cache_file": {
      "enabled": true,
      // 1.14：DNS 缓存落盘用 store_dns（store_rdrc 已弃用，1.16 移除）。
      // 放在 /tmp 是有意的：tmpfs，重启即失效，不写 flash、不磨损 NAND。
      "path": "/tmp/sing-box-cache.db",
      "store_dns": true
    }
  }
}
