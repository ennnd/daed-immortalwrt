# Newifi D2 (Newifi3) + ImmortalWrt 25.12.2 + sing-box-tiny 1.14.3
# 用法：复制为源码树根目录的 .config，然后 make defconfig

CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_DEVICE_ramips_mt7621_DEVICE_d-team_newifi-d2=y
CONFIG_TARGET_DEVICE_PACKAGES_ramips_mt7621_DEVICE_d-team_newifi-d2=""

# 保留 LuCI（需要更小体积可注释掉）
CONFIG_PACKAGE_luci=y

# sing-box tiny（不要选 full）
CONFIG_PACKAGE_sing-box-tiny=y
# CONFIG_PACKAGE_sing-box is not set

# TUN / tproxy 依赖
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_nftables=y
