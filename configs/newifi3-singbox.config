# Newifi D2 (Newifi3) + ImmortalWrt 25.12.2 + sing-box-tiny 1.14.3
# 用法：复制为源码树根目录的 .config，然后 make defconfig

CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
# 单设备编译用这个符号（choice "Target Profile" 里的一项）。
# 不要写 CONFIG_TARGET_DEVICE_ramips_mt7621_DEVICE_d-team_newifi-d2 —— 那是
# CONFIG_TARGET_MULTI_PROFILE=y（多设备）才可见的符号，看不到就会被 defconfig
# 静默丢弃，然后回退到该子目标的默认设备（ramips/mt7621 是 ADSLR G7）。
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y

# 保留 LuCI（需要更小体积可注释掉）
CONFIG_PACKAGE_luci=y

# sing-box tiny（不要选 full）
CONFIG_PACKAGE_sing-box-tiny=y
# CONFIG_PACKAGE_sing-box is not set

# TUN / tproxy 依赖
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
# nftables 是带变体的包（nftables-json / nftables-nojson），
# 写 CONFIG_PACKAGE_nftables=y 会被 defconfig 当成未知符号静默丢掉；
# firewall4 本来也依赖 nftables-json，这里写真实符号。
CONFIG_PACKAGE_nftables-json=y

# LuCI 面板（订阅导入 / 节点 / 分流 / 高级）
# 包本身放在仓库的 package/luci-app-singbox/，workflow 会拷进源码树。
CONFIG_PACKAGE_luci-app-singbox=y
# 中文界面。LUCI_LANG_zh_Hans 是 luci.mk 里 luci-base 的 Translations 选项，
# 开它之后 luci-i18n-singbox-zh-cn 会按 DEFAULT 自动带上（i18n 包本身 HIDDEN=1）。
CONFIG_LUCI_LANG_zh_Hans=y
# 订阅下载用 uclient-fetch，HTTPS 需要 ca-bundle（uclient-fetch 从 /etc/ssl/certs 读 CA）
CONFIG_PACKAGE_uclient-fetch=y
CONFIG_PACKAGE_ca-bundle=y

# singbox-subscribe / singbox-nodecheck 依赖 jq（解析订阅、比对节点）。
# 固件里必须预置：这两个脚本由 cron 调用，缺 jq 时只会在 syslog 里静默失败。
# base64 不需要 —— 解码走 jq 的 @base64d。
CONFIG_PACKAGE_jq=y

# ---------------------------------------------------------------- 排障工具
# 这台机器的 overlay 只有 12.5M，每次刷机都会清空，靠 opkg/apk 现装不现实
# （而且刷完墙还没通、apk 源可能拉不到）。下面这批是实际排障时反复要用、
# 但 busybox 里要么没编、要么残缺的工具。路由器上实测安装后占 1.1M（含依赖）。
#
# 取舍依据（都是这轮排障里真实卡过的地方）：
#   od        —— 查 .srs 魔数、DNS 报文、TUN 包内容；本镜像 busybox 没编 od，
#                当时只能退到 hexdump
#   timeout   —— busybox 也没编；脚本里想给命令加上限只能拿 "sleep N | nc" 凑
#   base64    —— 订阅/节点调试时手解；busybox 同样没编
#   socat     —— busybox 的 nc 没有 -z/-w，返回值也不可信（吃过误判的亏），
#                TCP/UDP 探测统一用它；也因此不再装 netcat（会和 /usr/bin/nc 抢文件）
#   tcpdump   —— 判断“连接到底有没有进 tun0”只能靠抓包，靠日志和路由表都是猜
#   ss        —— 看 53/9090 的 socket 状态与进程归属，比 netstat 信息全
#                （依赖 kmod-netlink-diag，由构建系统自动带上）
#   lsof      —— 谁占着端口 / 谁打开了 config.json
#   strace    —— 系统调用级定位，不用重新编固件
#
# 明确不装：
#   curl / bind-dig / drill —— 都依赖 libopenssl3（5.2M），仅为一个调试命令不值；
#                              取网页用 uclient-fetch，DNS 排查用 tcpdump + ss
#   mtr —— traceroute 已有，省 ncurses + terminfo 约 400K
CONFIG_PACKAGE_coreutils-od=y
CONFIG_PACKAGE_coreutils-timeout=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ss=y
CONFIG_PACKAGE_lsof=y
CONFIG_PACKAGE_strace=y
