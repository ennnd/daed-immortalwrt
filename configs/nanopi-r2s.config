# 全量编译固件时的 .config 片段
# 用法:
#   cat configs/nanopi-r2s.config >> .config
#   make defconfig
#
# 只保留关键项，其余交给 defconfig 自动补全。

# ---- 目标: FriendlyElec NanoPi R2S (rockchip/armv8) ----
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_friendlyarm_nanopi-r2s=y
CONFIG_TARGET_DEVICE_PACKAGES_rockchip_armv8_DEVICE_friendlyarm_nanopi-r2s=""

# ---- daed ----
CONFIG_PACKAGE_daed=y
CONFIG_PACKAGE_daed-geoip=y
CONFIG_PACKAGE_daed-geosite=y

# ---- 内核: dae/daed 运行所必需的 BTF/BPF 能力 ----
# 官方 25.12.2 镜像已经开启；自己全量编译时必须手动打开。
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_XDP_SOCKETS=y

# ---- BPF 工具链: 使用预编译 llvm-bpf（需把 tarball 解压到源码树根目录）----
CONFIG_BPF_TOOLCHAIN_PREBUILT=y
